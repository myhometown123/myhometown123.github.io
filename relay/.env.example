# ---- Gmail SMTP (the ONLY secret; never put it in the public site) ----
# Enable 2FA on the Gmail account, then create an App Password:
#   https://myaccount.google.com/apppasswords
# SMTP_USER=ckonkol@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
#
# Who receives the "city added" emails (defaults to SMTP_USER).
# RECIPIENT=ckonkol@gmail.com

# ---- shared saved-cities list (Vercel Postgres / Neon) ----
# On Vercel this is set for you when you enable Vercel Postgres. For local runs,
# point it at your Neon/Vercel Postgres connection string (usually the pooled URL,
# which already includes ?sslmode=require).
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ---- local run only (the host usually sets PORT for you) ----
# PORT=8787
